    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "8.17.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
}
