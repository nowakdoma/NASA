# Copy to .env and fill in. Never commit .env.
# NASA Earthdata (https://urs.earthdata.nasa.gov). NASA POWER needs no login.

# Personal Access Token (Earthdata profile -> "Generate Token"). Preferred: required for the
# LP DAAC cloud buckets (MODIS MOD13Q1, SRTM), where username/password returns 401.
EARTHDATA_TOKEN=

# Username/password: still used for NSIDC SMAP.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
