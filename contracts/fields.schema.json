{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/contracts/fields.schema.json",
  "title": "FieldShift fields (GeoJSON FeatureCollection)",
  "description": "Irrigated fields for one county with crop history, soil and season calendar. Coordinates are WGS84 lon/lat (EPSG:4326). Produced by pipeline/ + engine/, read by web/.",
  "type": "object",
  "required": ["type", "schema_version", "county", "years", "features"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "FeatureCollection" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "mock": {
      "type": "boolean",
      "description": "true when the file contains invented values"
    },
    "county": {
      "type": "object",
      "required": ["name", "state", "fips", "bbox"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "state": { "type": "string", "minLength": 2, "maxLength": 2 },
        "fips": { "type": "string", "pattern": "^\\d{5}$" },
        "bbox": {
          "description": "[min_lon, min_lat, max_lon, max_lat]",
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "years": {
      "description": "Inclusive [first, last] year of crop_history.",
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "crop_code": {
      "description": "Must match a crop_code in contracts/crops.csv (checked by engine.validate).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "year_key": { "type": "string", "pattern": "^(19|20)\\d{2}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date_range": {
      "type": "object",
      "required": ["year", "start", "end", "source"],
      "properties": {
        "year": { "type": "integer", "minimum": 1995, "maximum": 2100 },
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/date" },
        "source": {
          "type": "string",
          "description": "Dataset the window was derived from, e.g. 'MODIS MOD13Q1 NDVI'"
        },
        "note": { "type": "string" }
      }
    },
    "bare_period": {
      "allOf": [{ "$ref": "#/$defs/date_range" }],
      "unevaluatedProperties": false,
      "properties": {
        "year": true,
        "start": true,
        "end": true,
        "source": true,
        "note": true
      }
    },
    "stress_window": {
      "allOf": [{ "$ref": "#/$defs/date_range" }],
      "required": ["type", "severity"],
      "unevaluatedProperties": false,
      "properties": {
        "year": true,
        "start": true,
        "end": true,
        "source": true,
        "note": true,
        "type": { "enum": ["water", "heat"] },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = none, 1 = extreme"
        }
      }
    },
    "soil": {
      "type": "object",
      "required": ["texture", "om_pct", "kffact", "awc_mm", "slope_pct"],
      "additionalProperties": false,
      "properties": {
        "map_unit": { "type": "string", "description": "SSURGO map unit name" },
        "texture": {
          "type": "string",
          "description": "USDA texture class, e.g. 'silt loam'"
        },
        "om_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Organic matter, % (SSURGO om_r, surface horizon)"
        },
        "kffact": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.7,
          "description": "RUSLE K factor, rock-free (SSURGO kffact); t·ha·h/(ha·MJ·mm) in US-customary-derived units"
        },
        "awc_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "description": "Available water capacity of the root zone, mm"
        },
        "slope_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Mean slope, % (SRTM 30 m)"
        }
      }
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": "string" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "enum": ["Polygon", "MultiPolygon"] },
            "coordinates": { "type": "array", "minItems": 1 }
          }
        },
        "properties": {
          "type": "object",
          "required": [
            "field_id",
            "area_ha",
            "irrigated",
            "crop_history",
            "soil",
            "season_calendar",
            "stress_index_by_year"
          ],
          "additionalProperties": false,
          "properties": {
            "field_id": { "type": "string", "pattern": "^[A-Z]{3}-\\d{3}$" },
            "name": { "type": "string" },
            "area_ha": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
            "irrigated": { "type": "boolean" },
            "irrigation_type": { "enum": ["center_pivot", "flood", "drip", "none", "unknown"] },
            "crop_history": {
              "description": "Dominant CDL crop per year, {\"2008\": \"corn\", ...}. Every year in `years` must be present (engine.validate).",
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/year_key" },
              "additionalProperties": { "$ref": "#/$defs/crop_code" },
              "minProperties": 1
            },
            "soil": { "$ref": "#/$defs/soil" },
            "season_calendar": {
              "type": "object",
              "required": ["bare_periods", "stress_windows"],
              "additionalProperties": false,
              "properties": {
                "bare_periods": { "type": "array", "items": { "$ref": "#/$defs/bare_period" } },
                "stress_windows": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/stress_window" }
                }
              }
            },
            "stress_index_by_year": {
              "description": "Combined water+heat stress index per growing season, 0 (none) – 1 (extreme).",
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/year_key" },
              "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
